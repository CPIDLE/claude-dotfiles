# === Google Workspace Integration (optional) ===
# See docs/google-workspace-setup.md for setup instructions
CHAT_WEBHOOK_URL=<YOUR_CHAT_WEBHOOK_URL>
DASHBOARD_SHEET_ID=<YOUR_DASHBOARD_SHEET_ID>
APPS_SCRIPT_WEB_APP_ID=<YOUR_APPS_SCRIPT_WEB_APP_ID>

# === AnnSinHome LINE data query (optional) ===
# See docs/line-data-sop.md — lets docs/line-data-sop/scripts/gas_query.py
# work on any machine without the AnnSinHome_v0 repo/docker
ANNSINHOME_GAS_PULL_URL=<SAME_VALUE_AS_ANNSINHOME_V0_ENV_GAS_PULL_URL>
ANNSINHOME_GAS_TOKEN=<SAME_VALUE_AS_ANNSINHOME_V0_ENV_GAS_TOKEN>

# === OpenCode / Gemini (optional, only if using opencode) ===
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GOOGLE_GENERATIVE_AI_API_KEY=<YOUR_GEMINI_API_KEY>
